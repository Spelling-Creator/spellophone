 } RGROUP;
 
 typedef enum
@@ -1191,7 +1192,28 @@ static int __cdecl rgroup_sorter(RGROUP *a, RGROUP *b)
 	if (ix != 0) return ix;
 	ix = strcmp(a->name, b->name);
 	if (ix != 0) return ix;
-	return (uintptr_t)a->start - (uintptr_t)b->start;
