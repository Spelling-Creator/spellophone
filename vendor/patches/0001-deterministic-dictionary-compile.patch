+}
+
+// qsort() is not stable, and string_sorter() has ties (rules with the same
+// phoneme and match strings), so the order of tied rules, and with it the
+// bytes of the compiled dictionary, would depend on the C library. An
+// insertion sort keeps ties in file order on every platform. Groups hold at
+// most N_RULES entries, so the quadratic cost does not matter.
+static void stable_sort_rules(char **rules, int n_rules)
+{
+	int i, j;
+	char *key;
+
+	for (i = 1; i < n_rules; i++) {
+		key = rules[i];
+		j = i - 1;
+		while (j >= 0 && string_sorter(&rules[j], &key) > 0) {
+			rules[j+1] = rules[j];
+			j--;
+		}
+		rules[j+1] = key;
+	}
 }
 
 static void* output_rule_group(int n_rules, char **rules, char *name, size_t *outsize)
@@ -1213,7 +1235,7 @@ static void* output_rule_group(int n_rules, char **rules, char *name, size_t *ou
 
 	// sort the rules in this group by their phoneme string
 	common = "";
-	qsort((void *)rules, n_rules, sizeof(char *), (int(__cdecl *)(const void *, const void *))string_sorter);
