# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Fetched espeak-ng sources (pnpm fetch:espeak) and the wasm and data built
# from them (pnpm build). See apps/docs/docs/project/building.md.
vendor/espeak-ng/
packages/spellophone/wasm/
packages/spellophone/espeak-ng-data/

# VitePress
apps/docs/doc_build/
apps/docs/docs/.vitepress/cache/
apps/docs/docs/.vitepress/dist/

# Output of the Node example
examples/node/*.wav

# Logs
*.log
logs/

# OS
.DS_Store

# Playwright MCP/CLI screenshots and snapshots (browser verification artifacts)
.playwright-mcp/
.playwright-cli/

# Tarballs from pnpm pack (the release workflow packs one per release)
packages/spellophone/*.tgz
